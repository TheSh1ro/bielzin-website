{
  "name": "thesh1ro-webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot:lol": "node scripts/snapshot-lol.mjs",
    "snapshot:osu": "node scripts/snapshot-osu.mjs",
    "snapshot:chess": "node scripts/snapshot-chess.mjs",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && playwright test",
    "format": "prettier --write src/ scripts/ tests/ playwright.config.ts",
    "format:check": "prettier --check src/ scripts/ tests/ playwright.config.ts"
  },
  "dependencies": {
    "lucide-vue-next": "^0.563.0",
    "three": "^0.187.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.9",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.7.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
